class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if (head == NULL || head->next == NULL || k == 0)
            return head;

        ListNode* temp = head;
        int len = 1;

       
        while (temp->next != NULL) {
            temp = temp->next;
            len++;
        }

                temp->next = head;

        
        k = k % len;

        int steps = len - k;

        
        for (int i = 1; i < steps; i++) {
            head = head->next;
        }

               ListNode* newHead = head->next;
        head->next = NULL;

        return newHead;
    }
};
